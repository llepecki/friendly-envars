<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>disable</ImplicitUsings>
        <!--
          Declared here rather than passed on the command line, so every restore - the plain solution
          one and eng/trim-smoke.sh's runtime-specific one - evaluates the same graph and the committed
          packages.lock.json satisfies locked mode for both. PublishTrimmed additionally makes restore
          include the host's runtime, so the three supported host runtimes are declared: linux-x64,
          osx-arm64 and win-x64. Other hosts fail locked restore with NU1004; see the README's
          development note.
        -->
        <RuntimeIdentifiers>linux-x64;osx-arm64;win-x64</RuntimeIdentifiers>
        <!--
          Published by eng/trim-smoke.sh with PublishTrimmed and TrimMode=link, so a trim warning from
          the library surfaces here as a build error. The project itself stays warning-free too.
        -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!--
          Declared here so the trimming toolchain participates in restore and lands in the lock file.
          Passing PublishTrimmed only on the publish command line leaves the ILLink package out of the
          locked graph, and publish then silently skips trimming while still exiting 0.
        -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>link</TrimMode>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FriendlyEnvars\FriendlyEnvars.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <!--
          Pinned explicitly because the implicit reference PublishTrimmed adds tracks the SDK's own
          feature band, which would make the committed lock file rewrite itself under every other
          installed 10.0 SDK.
        -->
        <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.30" PrivateAssets="all" />
    </ItemGroup>
</Project>
