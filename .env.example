# Example environment for the README Quick Start.
#
# FriendlyEnvars reads process environment variables; it does not load .env files itself. This file
# documents the variable names for use with whatever exports them in your setup (your shell, your IDE,
# a container runtime, or a dotenv tool).
#
# Placeholder values only. Copy to .env and fill in real values there: every .env* file except this
# example is ignored by Git.
DB_HOST=db.example.invalid
DB_PORT=5432
DB_SSL_ENABLED=true
DB_CONNECTION_TIMEOUT=00:00:45
