<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore for every checked-in project uses nuget.org and nothing else. <clear /> drops any source
    inherited from a user- or machine-level NuGet.config, so a developer's private feed cannot silently
    become part of this repository's dependency graph.

    eng/smoke-consumer.sh is the sole exception. It builds its own isolated configuration in a temporary
    directory so it can resolve the candidate FriendlyEnvars package from a local folder, and it passes
    that file with an explicit configfile switch rather than relying on discovery.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    <clear /> above removes inherited sources but not inherited *disable* entries, which match by key.
    A machine that has disabled the key "nuget.org" globally - common when an organisation mandates a
    private mirror - would otherwise restore this repository with no enabled source at all and fail with
    a message that points nowhere near the cause.
  -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!--
    With mapping configured, a package is only ever resolved from a source it is mapped to. Every
    package maps to nuget.org, which is what makes the single-source rule enforced rather than merely
    configured: adding a source without also mapping packages to it changes nothing.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
