<Project>

  <!--
    Applies to every project in this repository. Transient consumer projects created under the OS
    temporary directory by eng/smoke-consumer.sh are outside this directory and deliberately unaffected,
    so they exercise a genuine consumer restore rather than this repository's settings.
  -->
  <PropertyGroup>

    <!--
      Every checked-in project records its complete resolved graph in packages.lock.json. CI and
      eng/verify-repository.sh restore in locked mode, which fails rather than silently resolving a
      different version, so a dependency cannot change without the lock file change appearing in review.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      NuGetAuditMode=all audits transitive packages, not just direct references; the vulnerable versions
      this repository has actually had to remove were transitive. NuGetAuditLevel=moderate sets the
      reporting floor. Low-severity advisories are still listed by eng/audit-dependencies.sh, which reads
      the full vulnerability data rather than the audit level, and are reported without failing.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <!--
      NU1902/NU1903/NU1904 are the moderate, high and critical advisory warnings. The library and the
      repository verifier set TreatWarningsAsErrors; the tests and sample do not, so without this they
      would restore with a vulnerability warning and still succeed.

      NU1900 is here for a different reason. It means the vulnerability data could not be retrieved, so
      the audit did not run at all - and an audit that did not run reports nothing, which is
      indistinguishable from a clean result. Failing on it makes the gate fail closed. NU1901 is
      deliberately absent: low-severity advisories are reported without failing.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1902;NU1903;NU1904</WarningsAsErrors>

  </PropertyGroup>

</Project>
